POSTGRES_DB=careservice
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# For local non-Docker commands. Docker Compose overrides DATABASE_URL for
# containers and uses the postgres service hostname automatically.
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/careservice
AVITO_ACCESS_TOKEN=
AVITO_ACCOUNT_ID=
AVITO_CLIENT_ID=
AVITO_CLIENT_SECRET=
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_MODERATOR_CHAT_IDS=[]
DEBOUNCE_SECONDS=
